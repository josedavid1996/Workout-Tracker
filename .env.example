# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Supabase instance URL (self-hosted). Leave empty to use the app's own
# origin (the Docker image does this and proxies Supabase through nginx).
VITE_SUPABASE_URL=http://your-supabase-host:8000

# Supabase anon (public) key for this instance. Safe for client-side use,
# but still keep it out of version control -- use your own local value.
VITE_SUPABASE_ANON_KEY=your-anon-key-here
